                {/* Grilla Modular de Artículos */}
                <div className="grid grid-cols-1 md:grid-cols-3 border border-white/15 divide-y md:divide-y-0 md:divide-x divide-white/15 bg-[#0f1420]">
                    {recent.map((post, idx) => (
