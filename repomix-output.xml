// Función para obtener las FAQs asociadas a una solución por su tag / slug
export const getFaqsBySolutionSlug = (slug) => {
        if (!slug) return [];
        return FAQS.filter(faq =>
                Array.isArray(faq.tags) && faq.tags.includes(slug.toLowerCase().trim())
        );
};

// Exportación nombrada para APIs y utilidades
export const faqsData = FAQS;

// Exportación por defecto para la página general /faq
export default FAQS;

